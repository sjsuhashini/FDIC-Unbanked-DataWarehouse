      DTS:ObjectName="Load DimCategory"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{032D3D60-7E46-4116-938B-0FED50B8DAD2}"
          SQLTask:SqlStatementSource="INSERT INTO DimCategory (CategoryType, CategoryValue)&#xA;SELECT DISTINCT&#xA;       s.CategoryType,&#xA;       s.CategoryValue&#xA;FROM Stage_UnbankedRaw s&#xA;LEFT JOIN DimCategory d&#xA;       ON s.CategoryType = d.CategoryType&#xA;      AND s.CategoryValue = d.CategoryValue&#xA;WHERE d.CategoryKey IS NULL&#xA;order by CategoryType;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load DimYear"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{962793D0-0449-4B56-B39C-280BBCFC8019}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load DimYear"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{032D3D60-7E46-4116-938B-0FED50B8DAD2}"
          SQLTask:SqlStatementSource="INSERT INTO DimYear (YearKey, Year)&#xA;SELECT DISTINCT&#xA;       s.Year,&#xA;       s.Year&#xA;FROM Stage_UnbankedRaw s&#xA;LEFT JOIN DimYear d&#xA;       ON s.Year = d.Year&#xA;WHERE d.Year IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
