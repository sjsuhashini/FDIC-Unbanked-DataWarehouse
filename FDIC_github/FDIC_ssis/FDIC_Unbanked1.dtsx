      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load FactTable"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{032D3D60-7E46-4116-938B-0FED50B8DAD2}"
          SQLTask:SqlStatementSource="INSERT INTO FactUnbankedHouseholds&#xA;(&#xA;    YearKey,&#xA;    CategoryKey,&#xA;    Households,&#xA;    Unbanked_Pct&#xA;)&#xA;SELECT *&#xA;FROM&#xA;(&#xA;    SELECT&#xA;        y.YearKey,&#xA;        c.CategoryKey,&#xA;        s.Households,&#xA;        s.Unbanked_Pct&#xA;      &#xA;    FROM Stage_UnbankedRaw s&#xA;    JOIN DimYear y&#xA;        ON y.Year = s.Year&#xA;    JOIN DimCategory c&#xA;        ON c.CategoryType = s.CategoryType&#xA;       AND c.CategoryValue = s.CategoryValue&#xA;) src&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM FactUnbankedHouseholds f&#xA;    WHERE f.YearKey = src.YearKey&#xA;      AND f.CategoryKey = src.CategoryKey&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
